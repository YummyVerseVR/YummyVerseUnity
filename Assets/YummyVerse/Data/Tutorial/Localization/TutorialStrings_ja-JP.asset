  m_TableData:
  - m_Id: 2364530688
    m_Localized: OK!
    m_Metadata:
      m_Items: []
  - m_Id: 2402279424
    m_Localized: "YummyVerse \u3078\u3088\u3046\u3053\u305D\u3002\nAI\u304C\u751F\u307F\u51FA\u3057\u305F\u98DF\u611F\u3092\u4F53\u9A13\u3057\u3066\u3044\u305F\u3060\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2758795264
    m_Localized: "\u76EE\u306E\u524D\u306E\u7D19\u76BF\u3092\u898B\u3064\u3081\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2758795265
    m_Localized: "AI\u30B7\u30A7\u30D5\u306E\u6E96\u5099\u304C\u3067\u304D\u305F\u3088\u3046\u3067\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3144671232
    m_Localized: "YummyVerse \u306E\u3054\u5229\u7528\u306F\u521D\u3081\u3066\u3067\u3059\u304B\uFF1F\n\u4EBA\u5DEE\u3057\u6307\u306E\u30DC\u30BF\u30F3\u3067\u9078\u629E\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3148865536
    m_Localized: "\u306F\u3058\u3081\u3066"
    m_Metadata:
      m_Items: []
  - m_Id: 3148865537
    m_Localized: "2\u56DE\u76EE\u4EE5\u964D"
    m_Metadata:
      m_Items: []
  - m_Id: 3153059840
    m_Localized: "試しにりんごを食べてみましょう。\nAボタンを押してください。"
    m_Metadata:
      m_Items: []
  - m_Id: 3509575680
    m_Localized: "\u30B9\u30D7\u30FC\u30F3\u3067\u98DF\u3079\u7269\u3092\u3059\u304F\u3063\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3694125056
    m_Localized: "\u305D\u306E\u8ABF\u5B50\u3067\u3059\u3002\u3053\u306E\u307E\u307E\u5B8C\u98DF\u3057\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3694125057
    m_Localized: "\u98DF\u4E8B\u4F5C\u6CD5\u306F\u304A\u5206\u304B\u308A\u3044\u305F\u3060\u3051\u307E\u3057\u305F\u304B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3861897216
    m_Localized: "\u305D\u308C\u3067\u306F\u3001\u98DF\u3079\u305F\u3044\u30E2\u30CE\u3092\u6CE8\u6587\u3057\u3066\u307F\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4247773184
    m_Localized: "\u304A\u597D\u304D\u306A\u30E1\u30CB\u30E5\u30FC\u3092\u304A\u9078\u3073\u304F\u3060\u3055\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4247773185
    m_Localized: "\u30A8\u30D3"
    m_Metadata:
      m_Items: []
  - m_Id: 4247773186
    m_Localized: "\u30AB\u30EC\u30FC"
    m_Metadata:
      m_Items: []
  - m_Id: 4247773187
    m_Localized: "\u30CF\u30F3\u30D0\u30FC\u30B0"
    m_Metadata:
      m_Items: []
  - m_Id: 4247773188
    m_Localized: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30C6\u30FC\u30AD"
    m_Metadata:
      m_Items: []
  - m_Id: 4247773189
    m_Localized: "\u5B8C\u98DF\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4428128256
    m_Localized: "\u307E\u305F\u306E\u3054\u6765\u5E97\u3092\u304A\u5F85\u3061\u3057\u3066\u304A\u308A\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5229240320
    m_Localized: "Aボタンを押してスタート"
    m_Metadata:
      m_Items: []
  - m_Id: 5229240321
    m_Localized: "食べ物の表示位置を設定してください。\n設定画面はAとXの同時押しで表示されます。"
    m_Metadata:
      m_Items: []
  - m_Id: 5229240322
    m_Localized: "小さく歯をカチカチしてください"
    m_Metadata:
      m_Items: []
  - m_Id: 5229240323
    m_Localized: "奥歯でちゃんと噛みしめてください"
    m_Metadata:
      m_Items: []
  - m_Id: 5229240324
    m_Localized: "計測中..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
